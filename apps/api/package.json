{
  "name": "@sentinelle/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "reset": "tsx src/reset.ts",
    "user:create": "tsx src/user-create.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:pg": "vitest run --no-file-parallelism",
    "db:backup": "tsx src/db-tools.ts backup",
    "db:restore": "tsx src/db-tools.ts restore",
    "user:list": "tsx src/users.ts list",
    "user:disable": "tsx src/users.ts disable",
    "user:enable": "tsx src/users.ts enable",
    "assistant:check": "tsx src/assistant-check.ts",
    "alert:check": "tsx src/alert-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/static": "^10",
    "@sentinelle/contracts": "workspace:*",
    "@sentinelle/domain": "workspace:*",
    "fastify": "^5",
    "pg": "^8",
    "tsx": "^4",
    "ws": "^8.23.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/ws": "^8.18.2",
    "typescript": "5.9.3",
    "vitest": "^5"
  }
}
