# Copier ce fichier en « .env » dans ce même dossier (sentinelle/.env). Le fichier .env n'est jamais versionné.
# Le serveur le lit au démarrage. Aucune valeur n'est requise : sans clé, l'application fonctionne sans IA.
PORT=3000
HOST=127.0.0.1
# Vide = PostgreSQL embarqué (PGlite) dans data/pglite. Sinon, URL d'un serveur PostgreSQL :
DATABASE_URL=
# Dossier de la base embarquée ("memory" = base volatile, utile pour les tests)
DATA_DIR=
# Active le sélecteur de rôle et la réinitialisation. Ne pas mettre en ligne avec ce mode.
DEMO_MODE=true
# Mode authentifié (DEMO_MODE=false) : cookie « Secure » derrière HTTPS uniquement
COOKIE_SECURE=false

# --- Assistant « Parler à mon élevage » (Gemini) ---
# Clé créée dans Google AI Studio. Côté serveur uniquement : jamais dans le navigateur, une conversation, une capture ou Git.
# Valeur fictive ci-dessous : remplacez-la dans .env, pas ici.
GEMINI_API_KEY=
# Ne définissez pas aussi GOOGLE_API_KEY : les outils Google lui donnent la priorité.
# Nom du modèle : ne le recopiez pas d'une documentation. Lancez « pnpm assistant:check », qui liste
# les modèles réellement disponibles avec votre clé, puis recopiez ici le nom retenu.
GEMINI_MODEL=
# Facultatif : modèle utilisé si le premier répond « surchargé » (503), fréquent aux heures de pointe.
GEMINI_FALLBACK_MODEL=
# Réponses parlées : modèle de synthèse vocale (son nom contient « tts » dans la liste de « pnpm assistant:check »).
# Vide = les réponses sont lues par la voix de synthèse de l'appareil, si elle existe.
GEMINI_TTS_MODEL=
# Voix préconstruite du modèle (par exemple Kore). Facultatif.
GEMINI_TTS_VOICE=
# Conversation en direct (API Live) : le modèle écoute et répond à la voix. Exemple : gemini-3.8-live.
# Vide = conversation en direct indisponible ; la dictée (GEMINI_MODEL) et le texte restent.
GEMINI_LIVE_MODEL=
# Durée maximale d'une conversation (30 à 540 s), silence qui la ferme (10 à 120 s), silence qui marque la fin d'une phrase (300 à 2000 ms).
LIVE_MAX_SESSION_SECONDS=300
LIVE_IDLE_SECONDS=30
LIVE_SILENCE_MS=700
# Durée cumulée de toutes les conversations en direct depuis le démarrage du serveur (borne la consommation si le lien circule).
LIVE_MAX_TOTAL_SECONDS=3600
# Secours de démonstration : « off » coupe l'assistant IA sans retirer la clé (lecture directe des données).
ASSISTANT_AI=
# Limites de consommation et de durée
ASSISTANT_TIMEOUT_MS=20000
ASSISTANT_MAX_REQUESTS_PER_SESSION=40
ASSISTANT_MAX_TOOL_ROUNDS=4
# Durée maximale d'une dictée, en secondes (5 à 60). L'enregistrement est transcrit puis jeté, jamais stocké.
VOICE_MAX_SESSION_SECONDS=30

# --- Aide IA de la console d'enquête (facultative, désactivée si vide) ---
# AI_PROVIDER = anthropic | openai-compatible (Ollama : AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=llama3.1)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_CALLS_PER_DAY=100

# --- E-mail d'alerte d'éloignement (facultatif, désactivé par défaut) ---
# Un message, et un seul, part quand une balise ouvre un incident, avec un lien direct vers cet incident.
# Fournisseur : Resend (https://resend.com), palier gratuit. Sans domaine vérifié, Resend n'envoie qu'à l'adresse du compte.
# 1. Créer un compte Resend, puis une clé d'API (une clé limitée à l'envoi suffit). 2. Renseigner les lignes ci-dessous.
# 3. Vérifier : « pnpm alert:check », puis « pnpm alert:check --envoyer » pour un message d'essai réel. 4. Relancer le serveur.
ALERT_EMAIL=off
ALERT_EMAIL_PROVIDER=resend
# Clé secrète : ne jamais la coller dans une conversation ni la versionner.
RESEND_API_KEY=
# Destinataire de test, une seule adresse, qui a accepté de recevoir ces messages (avec Resend sans domaine : celle du compte).
ALERT_EMAIL_TO=
# Expéditeur. Laisser vide pour l'expéditeur d'essai de Resend (onboarding@resend.dev).
ALERT_EMAIL_FROM=
# Adresse publique de l'application, utilisée pour le lien du message (par exemple celle du tunnel). À mettre à jour si elle change.
PUBLIC_URL=

# Voix en baoulé (note vocale) : désactivée par défaut. Suppose les modèles ouverts téléchargés dans data/baoule et le
# service local de parole lancé (tools/baoule/serveur.py). Voir docs/BAOULE.md, section 6.
BAOULE_VOICE=off
# Adresse du service local de parole (défaut : http://127.0.0.1:8765)
BAOULE_URL=

# --- Balises : suivi automatique des appareils (mode démonstration) ---
# Tout appareil qui ouvre le lien et autorise sa position est suivi. Chaque écran relit les balises toutes les 2 secondes :
# pendant cette durée (ms), tous les écrans reçoivent la même lecture, pour soulager le serveur. 0 = chaque écran relit.
BEACONS_READ_CACHE_MS=1000
