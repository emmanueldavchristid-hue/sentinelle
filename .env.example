# Copier ce fichier en « .env » dans ce même dossier (sentinelle/.env). Le fichier .env n'est jamais versionné.
# Le serveur le lit au démarrage. Aucune valeur n'est requise : sans clé, l'application fonctionne sans IA.
PORT=3000
HOST=127.0.0.1
# Vide = PostgreSQL embarqué (PGlite) dans data/pglite. Sinon, URL d'un serveur PostgreSQL :
DATABASE_URL=
# Dossier de la base embarquée ("memory" = base volatile, utile pour les tests)
DATA_DIR=
# Active le sélecteur de rôle et la réinitialisation. Ne pas mettre en ligne avec ce mode.
DEMO_MODE=true
# Mode authentifié (DEMO_MODE=false) : cookie « Secure » derrière HTTPS uniquement
COOKIE_SECURE=false

# --- Assistant « Parler à mon élevage » (Gemini) ---
# Clé créée dans Google AI Studio. Côté serveur uniquement : jamais dans le navigateur, une conversation, une capture ou Git.
# Valeur fictive ci-dessous : remplacez-la dans .env, pas ici.
GEMINI_API_KEY=
# Ne définissez pas aussi GOOGLE_API_KEY : les outils Google lui donnent la priorité.
# Nom du modèle : ne le recopiez pas d'une documentation. Lancez « pnpm assistant:check », qui liste
# les modèles réellement disponibles avec votre clé, puis recopiez ici le nom retenu.
GEMINI_MODEL=
# Facultatif : modèle utilisé si le premier répond « surchargé » (503), fréquent aux heures de pointe.
GEMINI_FALLBACK_MODEL=
# Réservé à une future conversation vocale en direct (API Live) : non utilisé aujourd'hui. La dictée utilise GEMINI_MODEL.
GEMINI_LIVE_MODEL=
# Secours de démonstration : « off » coupe l'assistant IA sans retirer la clé (lecture directe des données).
ASSISTANT_AI=
# Limites de consommation et de durée
ASSISTANT_TIMEOUT_MS=20000
ASSISTANT_MAX_REQUESTS_PER_SESSION=40
ASSISTANT_MAX_TOOL_ROUNDS=4
# Durée maximale d'une dictée, en secondes (5 à 60). L'enregistrement est transcrit puis jeté, jamais stocké.
VOICE_MAX_SESSION_SECONDS=30

# --- Aide IA de la console d'enquête (facultative, désactivée si vide) ---
# AI_PROVIDER = anthropic | openai-compatible (Ollama : AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=llama3.1)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_CALLS_PER_DAY=100
